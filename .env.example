PORT=3000

# Razorpay TEST MODE only
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Set this to whatever secret you configure in the Razorpay Dashboard webhook
# settings. If left blank, /api/webhook still runs (for local demoing) but
# every incoming event is flagged as UNVERIFIED in the audit trail instead of
# silently trusted.
RAZORPAY_WEBHOOK_SECRET=

# Optional AI provider. If neither is set, RecoverAI uses its deterministic
# recovery policy so the demo still works offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
